{
  "name": "color-battle",
  "private": true,
  "scripts": {
    "dev": "pnpm -r --parallel dev",
    "dev:client": "pnpm --filter @color-battle/client dev",
    "dev:server": "pnpm --filter @color-battle/server dev",
    "build": "pnpm --filter @color-battle/client build",
    "start": "pnpm --filter @color-battle/server start",
    "typecheck": "pnpm -r typecheck"
  },
  "engines": {
    "node": ">=18"
  }
}
